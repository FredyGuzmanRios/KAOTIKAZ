# Copia a .env (local) o configura como variables de entorno en Coolify.
# NUNCA subas el .env real a GitHub.

PORT=3000

# Cifrado en reposo (AES-256-GCM). Genera la tuya:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=aqui_va_tu_key_de_64_caracteres_hex

# Brevo (envío transaccional)
BREVO_API_KEY=xkeysib-...

# Google service account (ruta al JSON o contenido en base64)
GOOGLE_CREDENTIALS_JSON=...
SHEETS_ID=...
DRIVE_FOLDER_ID=...

# Panel staff (guarda el HASH bcrypt, no la contraseña plana)
ADMIN_USER=staff
ADMIN_PASSWORD_HASH=$2b$12$...
