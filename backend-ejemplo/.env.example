# Copia a .env (local) o configura como variables de entorno en Coolify.
# NUNCA subas el .env real a GitHub. Ver SETUP.md para obtener cada valor.

PORT=3000
NODE_ENV=development

# ── Cifrado en reposo (AES-256-GCM). Genera la tuya:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=aqui_va_tu_key_de_64_caracteres_hex

# ── Firma de cookies de sesión del panel staff. Genera otra distinta:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=otra_key_hex_distinta

# ── Brevo (correos transaccionales) — SETUP.md §3
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=boletos@tudominio.com
BREVO_SENDER_NAME=Kaotikaz

# ── Notificaciones al organizador
ADMIN_EMAIL=fredyogr@gmail.com
# WhatsApp con código de país, solo dígitos (México: 521 + 10 dígitos)
ADMIN_WHATSAPP=5215512345678

# ── Google service account — SETUP.md §2
# JSON de credenciales codificado en base64 (una sola línea):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("credenciales.json"))
#   Linux/Mac:  base64 -w0 credenciales.json
GOOGLE_CREDENTIALS_B64=...
SHEETS_ID=...
DRIVE_FOLDER_ID=...

# ── Panel staff (hash bcrypt, NO la contraseña plana)
# Generar: npm run hash-password -- "TuContraseñaSegura"
ADMIN_USER=staff
ADMIN_PASSWORD_HASH=$2b$12$...

# ── Cloudflare Turnstile (CAPTCHA gratis) — SETUP.md §9
# Si los dejas vacíos, el sitio funciona SIN captcha (útil en local).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Precio del boleto: NORMALMENTE se deja vacía. El precio real lo
# decide lib/precio.js por fecha (tabla de etapas en el código).
# Solo llena esta variable como override de emergencia (fuerza un precio
# YA, sin esperar redeploy) — mientras esté definida, gana sobre la tabla.
#PRECIO_BOLETO=400
